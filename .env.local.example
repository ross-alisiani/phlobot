# ============================================================
# Phlobot Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to GitHub.
# ============================================================

# --- Supabase ---
# From: supabase.com → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# --- Twilio (SMS) ---
# From: console.twilio.com → Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+17205550100

# --- Resend (Email) ---
# From: resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=noreply@yourdomain.com

# --- App ---
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# --- Admin ---
# Comma-separated list of email addresses that have admin access
ADMIN_EMAILS=ross@youremail.com

# --- Cron Security ---
# Any random string — used to protect the cron endpoint
CRON_SECRET=a_random_secret_string_here
